NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=server_only_key
OPENAI_API_KEY=server_only_openai_key
# Usado apenas por integrações legadas sem escolha de modelo no frontend.
OPENAI_EXAM_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini
# Simulação de leitura de exames com valores inventados. Só para testes locais, nunca em produção.
# PSYWRITE_DEMO_AI=1

# Assinatura Digital ICP-Brasil (Bird ID / Vault ID)
BIRDID_BASE_URL=https://api.birdid.com.br/v0
BIRDID_CLIENT_ID=
BIRDID_CLIENT_SECRET=
BIRDID_REDIRECT_URI=http://localhost:3000/api/digital-signature/birdid/callback
# VIDaaS (Valid): mesma API padrão do ITI. Sem credenciais, a opção não aparece na tela.
# O endereço abaixo é o de produção; a homologação usa outro, informado pela Valid.
VIDAAS_BASE_URL=https://certificado.vidaas.com.br/v0
VIDAAS_CLIENT_ID=
VIDAAS_CLIENT_SECRET=
VIDAAS_REDIRECT_URI=http://localhost:3000/api/digital-signature/birdid/callback
# Chave secreta de 32 bytes em hexadecimal (64 caracteres hex) para criptografia AES-256-GCM dos tokens de sessão
SIGNATURE_ENCRYPTION_KEY=

# Integração SNCR — Anvisa (RDC nº 1.000/2025 — Prescrição Eletrônica de Controlados)
# Padrão seguro: 'hmg'. Operações externas continuam bloqueadas até homologação/autenticação.
ANVISA_SNCR_ENV=hmg
# Credenciais legadas; não substituem a sessão individual gov.br do prescritor (Lote 4).
ANVISA_SNCR_CLIENT_ID=
ANVISA_SNCR_CLIENT_SECRET=
# Mantenedora jurídica do PsyWrite — apenas backend, sem prefixo NEXT_PUBLIC_.
# CNPJ da PLATAFORMA; não preencher com o CNPJ da clínica/estabelecimento do prescritor.
# Configuração identifica uma candidata; não comprova habilitação ou homologação Anvisa.
PSYWRITE_MAINTAINER_LEGAL_NAME=
PSYWRITE_MAINTAINER_CNPJ=
# ANVISA_SNCR_CNPJ é legado ambíguo: não é usado como fallback para a mantenedora.
# Opcionais (padrão automático conforme ANVISA_SNCR_ENV):
# ANVISA_SNCR_BASE_URL=https://api-gateway.prd.apps.anvisa.gov.br/api-sncr
# ANVISA_SNCR_TOKEN_URL=https://acesso.prd.apps.anvisa.gov.br/auth/realms/externo/protocol/openid-connect/token
# ANVISA_SNCR_JWS_INTEGRADORA=  # Legado sem uso no fluxo atual; não implica exigência de e-CNPJ.

# Painel de assinantes (Ajustes): ids de auth.users do titular da plataforma, separados por vírgula.
PSYWRITE_ADMIN_USER_IDS=
