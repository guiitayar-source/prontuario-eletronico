{
  "name": "psywrite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "tsc --noEmit && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --test \"tests/*.mjs\"",
    "test:supabase": "node tests/local/supabase-flow.mjs",
    "test:consultations": "node tests/local/consultations.mjs",
    "test:timer": "node --test tests/timer-utils.test.mjs",
    "test:documents": "node tests/local/documents.mjs",
    "test:document-ai": "node tests/local/document-ai.mjs",
    "test:team": "node tests/local/team.mjs",
    "test:invite": "node tests/local/invite-flow.mjs",
    "test:clinical-context": "node tests/local/clinical-context.mjs",
    "test:imports": "node tests/local/imports.mjs",
    "test:readiness": "node tests/local/readiness.mjs",
    "test:exams": "node tests/exams.test.mjs && node tests/exams-db.mjs",
    "test:attachment-delete": "node tests/attachment-delete-db.mjs",
    "test:signature": "node tests/digital-signature.test.mjs",
    "test:sncr": "node --test tests/sncr.test.mjs tests/sncr-db.test.mjs tests/sncr-rce.test.mjs",
    "test:signature-flow": "node tests/evolution-save-before-sign.test.mjs",
    "test:anamnesator": "node tests/anamnesator-native-db.mjs && node tests/anamnesator-native-http.test.mjs && node tests/anamnesator-private-session.test.mjs",
    "verify-signature": "node scripts/verify-signature.mjs",
    "backup:create": "node --env-file=.env.local scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "test:sncr:lab": "node scripts/sncr-rce-lab.mjs",
    "test:sncr:build": "node tests/local/sncr-rce-build.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "asn1js": "^3.0.10",
    "lucide-react": "1.31.0",
    "next": "^16.3.5",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "supabase": "^2.117.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
